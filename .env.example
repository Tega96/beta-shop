# ==========================================================
# BETA PHONE SHOP - ENVIRONMENT VARIABLES CONFIGURATION
# ==========================================================

# 1. DATABASE (Neon or Supabase PostgreSQL)
# Example Neon: postgresql://username:password@ep-cool-fog-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
# Example Supabase: postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?pgbouncer=true
# (Or direct connection string from Supabase Settings -> Database)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/beta_shop?schema=public"

# 2. NEXTAUTH CONFIGURATION
# You can generate a random secret via: openssl rand -base64 32
NEXTAUTH_SECRET="beta-shop-development-secret-change-in-production-12345"
NEXTAUTH_URL="http://localhost:3000"

# 3. GOOGLE OAUTH (Google Cloud Console)
# Setup steps:
# 1. Go to https://console.cloud.google.com/
# 2. Create a project -> APIs & Services -> Credentials
# 3. Create OAuth 2.0 Client ID (Web application)
# 4. Authorized JavaScript origins: http://localhost:3000
# 5. Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# 4. MAILGUN CONFIGURATION
# Setup steps:
# 1. Sign up at https://www.mailgun.com/
# 2. Go to Sending -> Domains (use sandbox domain for testing or your verified domain)
# 3. Find your API Key under Settings -> API Keys (or Sending API keys)
MAILGUN_API_KEY="key-your-mailgun-api-key"
MAILGUN_DOMAIN="sandbox123456789abcdef.mailgun.org"
MAILGUN_HOST="api.mailgun.net" # or api.eu.mailgun.net if using European Mailgun servers
EMAIL_FROM="Beta Shop <orders@sandbox123456789abcdef.mailgun.org>"
